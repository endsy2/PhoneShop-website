# Rules without a leading "/" apply in every folder (API, Admin-Section, User-Section).

# Dependencies & build output
node_modules/
dist/
dist-ssr/
coverage/
*.tsbuildinfo

# Secrets: keep only the templates
.env
.env.*
!.env.example
*.local
*.pem
*.key

# User-uploaded images (product/brand photos, avatars): runtime data, not source
API/uploads/
API/upload/

# Local database dumps for docker-compose (see docker-compose.yml)
database/
*.sql.gz

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Deploy / tool caches
.vercel/
.eslintcache
.cache/

# OS & editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.sw?

# Stray lockfile: the repo root is not an npm project
/package-lock.json
