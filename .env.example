# Copy to .env (never commit .env) and fill in. Used by docker-compose.yml.

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=phone_shop
MYSQL_USER=phoneshop
MYSQL_PASSWORD=change-me

# Login tokens: long random strings, e.g. `openssl rand -hex 32`
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
JWT_ACCESS_EXPIRED=1d
JWT_REFRESH_EXPIRED=7d

# API address as the browser sees it (baked into the frontends at build time)
PUBLIC_API_URL=http://localhost:3000

# Bakong KHQR payments (optional; checkout by QR won't work without them)
BAKONG_TOKEN=
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_ID=
ACQUIRINGBANK=
MERCHANTNAME=
STORELABEL=GeniusStore
MOBILENUMBERSTORELABEL=
