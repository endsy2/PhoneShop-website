// PhoneShop database schema (Prisma 7, MySQL 8).
//
// Catalog hierarchy:  Brand / Category -> Product -> ProductColor -> ProductVariant (the sellable SKU)
//   Product        model-level specs that never change per SKU (screen, chip, battery, camera)
//   ProductColor   a color of a product; owns the images
//   ProductVariant RAM/storage combo of a color; owns price + stock. Cart and orders point here.
//
// Conventions: models are PascalCase, tables/columns are snake_case via @@map/@map.
// Money is DECIMAL (never FLOAT). Order lines snapshot name/price so history survives catalog edits.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────
// Lowercase values match what the frontends already send/compare against.

// What each role may do lives in Utils/rbac.js (ROLE_PERMISSIONS); routes check permissions.
enum Role {
  customer
  support
  manager
  admin
}

enum OrderStatus {
  pending
  completed
  shipping
  delivered
  canceled
}

enum PaymentMethod {
  cash_on_delivery
  bakong_qr
}

enum PaymentStatus {
  unpaid
  paid
  failed
}

enum ChatStatus {
  waiting
  open
  closed
}

enum VoteType {
  helpful
  unhelpful
}

// ─── Users ──────────────────────────────────────────────────────────────────
// Customers and admins share one table; `role` tells them apart. This lets chat,
// reviews and orders reference a single user id instead of (id, type) pairs.

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(customer)
  phoneNumber  String?  @map("phone_number") @db.VarChar(30)
  avatarUrl    String?  @map("avatar_url") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  addresses       Address[]
  orders          Order[]
  reviews         Review[]
  reviewVotes     ReviewVote[]
  productViews    ProductView[]
  chatsAsCustomer ChatConversation[] @relation("ChatCustomer")
  chatsAsAdmin    ChatConversation[] @relation("ChatAdmin")
  chatMessages    ChatMessage[]

  @@index([role])
  @@map("users")
}

model Address {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  recipientName String?  @map("recipient_name") @db.VarChar(100)
  phoneNumber   String?  @map("phone_number") @db.VarChar(30)
  provinceCity  String?  @map("province_city") @db.VarChar(100)
  district      String?  @db.VarChar(100)
  street        String?  @db.VarChar(255)
  houseNo       String?  @map("house_no") @db.VarChar(50)
  detail        String?  @db.VarChar(500) // free-text line (landmarks, old single-field address)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@map("addresses")
}

// ─── Catalog ────────────────────────────────────────────────────────────────

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("brands")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

model Product {
  id           Int       @id @default(autoincrement())
  name         String    @unique @db.VarChar(255)
  description  String?   @db.Text
  brandId      Int       @map("brand_id")
  categoryId   Int       @map("category_id")
  releaseDate  DateTime? @map("release_date") @db.Date
  screenSizeIn Decimal?  @map("screen_size_in") @db.Decimal(3, 1)
  processor    String?   @db.VarChar(100)
  batteryMah   Int?      @map("battery_mah") @db.UnsignedInt
  camera       String?   @db.VarChar(255) // e.g. "48MP + 12MP", kept as text
  isActive     Boolean   @default(true) @map("is_active") // hide instead of deleting sold products
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  brand    Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  colors   ProductColor[]
  reviews  Review[]

  @@index([brandId])
  @@index([categoryId])
  @@index([releaseDate])
  @@index([isActive, releaseDate])
  @@map("products")
}

model ProductColor {
  id        Int    @id @default(autoincrement())
  productId Int    @map("product_id")
  name      String @db.VarChar(50)

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  images   ProductImage[]
  variants ProductVariant[]

  @@unique([productId, name])
  @@map("product_colors")
}

model ProductImage {
  id        Int    @id @default(autoincrement())
  colorId   Int    @map("color_id")
  url       String @db.VarChar(500)
  sortOrder Int    @default(0) @map("sort_order") @db.SmallInt

  color ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@index([colorId, sortOrder])
  @@map("product_images")
}

model ProductVariant {
  id            Int      @id @default(autoincrement())
  colorId       Int      @map("color_id")
  ramGb         Int      @map("ram_gb") @db.UnsignedSmallInt
  storageGb     Int      @map("storage_gb") @db.UnsignedSmallInt
  price         Decimal  @db.Decimal(10, 2)
  stock         Int      @default(0) @db.UnsignedInt
  reservedStock Int      @default(0) @map("reserved_stock") @db.UnsignedInt
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  color        ProductColor  @relation(fields: [colorId], references: [id], onDelete: Cascade)
  promotions   Promotion[]
  orderItems   OrderItem[]
  productViews ProductView[]

  @@unique([colorId, ramGb, storageGb])
  @@index([price])
  @@index([storageGb])
  @@index([ramGb])
  @@map("product_variants")
}

// Status is NOT stored: a promotion is live when isActive AND now() BETWEEN startsAt AND endsAt.
model Promotion {
  id              Int      @id @default(autoincrement())
  variantId       Int      @map("variant_id")
  name            String   @db.VarChar(255)
  discountPercent Decimal  @map("discount_percent") @db.Decimal(5, 2)
  startsAt        DateTime @map("starts_at")
  endsAt          DateTime @map("ends_at")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, startsAt, endsAt])
  @@index([isActive, endsAt])
  @@map("promotions")
}

// ─── Orders ─────────────────────────────────────────────────────────────────
// Totals are written by the app inside the checkout transaction (replaces the old MySQL triggers).

model Order {
  id              Int           @id @default(autoincrement())
  userId          Int           @map("user_id")
  status          OrderStatus   @default(pending)
  paymentMethod   PaymentMethod @map("payment_method")
  paymentStatus   PaymentStatus @default(unpaid) @map("payment_status")
  deliveryMethod  String        @map("delivery_method") @db.VarChar(50)
  recipientName   String        @map("recipient_name") @db.VarChar(100)
  recipientPhone  String?       @map("recipient_phone") @db.VarChar(30)
  shippingAddress String        @map("shipping_address") @db.VarChar(500) // snapshot, not a FK
  subtotal        Decimal       @db.Decimal(12, 2)
  discountTotal   Decimal       @default(0) @map("discount_total") @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  bakongMd5       String?       @unique @map("bakong_md5") @db.VarChar(64)
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  orderId         Int     @map("order_id")
  variantId       Int?    @map("variant_id") // null once the variant is deleted; snapshot below remains
  productName     String  @map("product_name") @db.VarChar(255)
  colorName       String  @map("color_name") @db.VarChar(50)
  ramGb           Int     @map("ram_gb") @db.UnsignedSmallInt
  storageGb       Int     @map("storage_gb") @db.UnsignedSmallInt
  unitPrice       Decimal @map("unit_price") @db.Decimal(10, 2)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  quantity        Int     @db.UnsignedInt
  lineTotal       Decimal @map("line_total") @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

// ─── Reviews ────────────────────────────────────────────────────────────────
// One review per user per product (the UI shows reviews per product, not per SKU).
// Helpful/unhelpful counts are derived from review_votes, never stored twice.

model Review {
  id                 Int      @id @default(autoincrement())
  productId          Int      @map("product_id")
  userId             Int      @map("user_id")
  rating             Int      @db.UnsignedTinyInt
  title              String?  @db.VarChar(255)
  comment            String?  @db.Text
  isVerifiedPurchase Boolean  @default(false) @map("is_verified_purchase")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes   ReviewVote[]

  @@unique([productId, userId])
  @@index([productId, createdAt])
  @@map("reviews")
}

model ReviewVote {
  reviewId  Int      @map("review_id")
  userId    Int      @map("user_id")
  type      VoteType
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
  @@index([userId])
  @@map("review_votes")
}

// ─── Recommendations ────────────────────────────────────────────────────────

model ProductView {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  variantId Int      @map("variant_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@index([variantId, viewedAt])
  @@map("product_views")
}

// ─── Support chat ───────────────────────────────────────────────────────────

model ChatConversation {
  id         Int        @id @default(autoincrement())
  customerId Int        @map("customer_id")
  adminId    Int?       @map("admin_id")
  roomCode   String     @unique @map("room_code") @db.VarChar(50)
  status     ChatStatus @default(waiting)
  startedAt  DateTime   @default(now()) @map("started_at")
  closedAt   DateTime?  @map("closed_at")

  customer User          @relation("ChatCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  admin    User?         @relation("ChatAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([customerId, status])
  @@index([adminId, status])
  @@index([status, startedAt])
  @@map("chat_conversations")
}

// Sender role comes from users.role, so no separate sender_type column.
model ChatMessage {
  id             Int       @id @default(autoincrement())
  conversationId Int       @map("conversation_id")
  senderId       Int       @map("sender_id")
  body           String    @db.Text
  attachmentUrl  String?   @map("attachment_url") @db.VarChar(500)
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

// ─── Notifications ──────────────────────────────────────────────────────────
// Replaces the in-memory fake_db array (lost on every restart / serverless cold start).

model Notification {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(255)
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("notifications")
}
